 "units": [
  {
   "id": "l1-01",
   "section": "一级",
   "title": "拼音、声调与第一句问候",
   "goal": "能读准声母、韵母和四个声调，用固定语块问候、道谢、道歉，听不懂时请对方再说一遍",
   "rationale": "入口：汉语的音节结构和声调是之后所有听说的底座；问候语块不需要任何语法",
   "kcs": [
    "kt:zh-pinyin-initials-finals",
    "kt:zh-pinyin-tones",
    "kt:zh-pinyin-spelling",
    "kt:zh-fn-greetings",
    "kt:zh-fn-thanks-apologies",
    "kt:zh-str-repair-basic",
    "kt:zh-fn-classroom-language"
   ]
  },
  {
   "id": "l1-02",
   "section": "一级",
   "title": "我是谁",
   "goal": "能说出并询问姓名、国籍、职业，介绍自己",
   "rationale": "\"是\"字句和\"吗\"问句是汉语判断与提问的第一个骨架",
   "kcs": [
    "kt:zh-shi-sentence",
    "kt:zh-ma-question",
    "kt:zh-bu-negation",
    "kt:zh-personal-pronouns",
    "kt:zh-wh-questions",
    "kt:zh-jiao-xing",
    "kt:zh-lex-personal-info",
    "kt:zh-fn-self-introduction",
    "kt:zh-tone-sandhi"
   ]
  },
  {
   "id": "l1-03",
   "section": "一级",
   "title": "这是什么、谁的",
   "goal": "能指着东西问名称、主人，说数量",
   "rationale": "指示代词和\"的\"表领属；量词是汉语名词短语的必需成分，越早越好",
   "kcs": [
    "kt:zh-demonstratives",
    "kt:zh-de-possessive",
    "kt:zh-numerals",
    "kt:zh-measure-words-basic",
    "kt:zh-hanzi-strokes",
    "kt:zh-hanzi-components",
    "kt:zh-hanzi-l1"
   ]
  },
  {
   "id": "l1-04",
   "section": "一级",
   "title": "数字、时间与日期",
   "goal": "能说出和听懂钟点、日期、星期、年龄和价格",
   "rationale": "时间词和数字是安排与交易的前提；汉语时间词放在动词前，顺序从大到小",
   "kcs": [
    "kt:zh-time-expressions",
    "kt:zh-nominal-predicate",
    "kt:zh-money-prices"
   ]
  },
  {
   "id": "l1-05",
   "section": "一级",
   "title": "我的家与我的东西",
   "goal": "能说家里有几口人、有什么东西、东西在哪儿",
   "rationale": "\"有\"表领有和存在，\"在\"表位置，是两个最基本的动词",
   "kcs": [
    "kt:zh-you-sentence",
    "kt:zh-ji-duoshao",
    "kt:zh-mei-negation",
    "kt:zh-zai-location",
    "kt:zh-locatives",
    "kt:zh-lex-family",
    "kt:zh-he-conjunction"
   ]
  },
  {
   "id": "l1-06",
   "section": "一级",
   "title": "我的一天",
   "goal": "能说每天几点做什么、在哪儿做、怎么去",
   "rationale": "动词谓语句加上时间、地点、方式状语，就能描述一天；汉语状语一律在动词前",
   "kcs": [
    "kt:zh-verb-predicate",
    "kt:zh-lex-daily-verbs",
    "kt:zh-time-word-order",
    "kt:zh-adverbs-basic",
    "kt:zh-lian-dong",
    "kt:zh-transport-zuo",
    "kt:zh-fn-daily-routine"
   ]
  },
  {
   "id": "l1-07",
   "section": "一级",
   "title": "喜欢、想要与能力",
   "goal": "能说喜欢什么、想做什么、会做什么",
   "rationale": "能愿动词\"想、要、会、能、可以\"表达意愿和能力，是最常用的情态手段",
   "kcs": [
    "kt:zh-xihuan",
    "kt:zh-xiang-yao",
    "kt:zh-hui-ability",
    "kt:zh-neng-keyi",
    "kt:zh-lex-food-drink",
    "kt:zh-fn-ordering"
   ]
  },
  {
   "id": "l1-08",
   "section": "一级",
   "title": "描述与评价",
   "goal": "能用形容词描述人和东西，作简单评价",
   "rationale": "形容词直接作谓语，前面通常要加\"很\"，这是和英语、日语都不同的地方",
   "kcs": [
    "kt:zh-adjective-predicate",
    "kt:zh-lex-common-adjectives",
    "kt:zh-le-modal-basic",
    "kt:zh-ne-ba-particles",
    "kt:zh-fn-describe-things"
   ]
  },
  {
   "id": "l1-09",
   "section": "一级",
   "title": "请求、邀请与建议",
   "goal": "能请人做事、邀请别人、提出建议并回应",
   "rationale": "祈使句加\"请\"\"吧\"，配合正反问，就能完成日常请求和邀约",
   "kcs": [
    "kt:zh-imperatives",
    "kt:zh-affirmative-negative-question",
    "kt:zh-haishi-question",
    "kt:zh-fn-invite-suggest",
    "kt:zh-verb-reduplication"
   ]
  },
  {
   "id": "l1-10",
   "section": "一级",
   "title": "读写听入门",
   "goal": "能读懂拼音和简单汉字写的告示、菜单与短句，听懂慢速日常短对话",
   "rationale": "把一级的语言知识汇总为可测的听读写任务",
