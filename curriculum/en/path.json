 "units": [
  {
   "id": "a1-01",
   "section": "A1",
   "title": "字母、声音与第一句问候",
   "goal": "能拼读自己的名字，用固定语块问候、介绍与告别，听不懂时请对方重复",
   "rationale": "入口：不需要任何语法就能完成真实交际；字母和语音是之后所有读写与听辨的底座",
   "kcs": [
    "kt:en-orth-alphabet",
    "kt:en-phon-sound-inventory",
    "kt:en-orth-spelling-aloud",
    "kt:en-fn-greetings",
    "kt:en-soc-politeness-basic",
    "kt:en-str-repair-basic",
    "kt:en-str-gesture-contact",
    "kt:en-fn-thanks-apologies"
   ]
  },
  {
   "id": "a1-15",
   "section": "A1",
   "title": "字母和声音的对应（自然拼读入门）",
   "goal": "能听出押韵和首音，拼读 cat、ship 这类规则单词，认读 the、said 等高频词，正确书写字母",
   "rationale": "紧跟字母名称：先会按字母读出声音，之后每个单元的新词都能自己读出来；低龄学习者从这里进入读写",
   "kcs": [
    "kt:en-phon-awareness",
    "kt:en-orth-letter-sounds",
    "kt:en-orth-cvc-decoding",
    "kt:en-orth-digraphs-blends",
    "kt:en-orth-sight-words",
    "kt:en-orth-handwriting"
   ]
  },
  {
   "id": "a1-02",
   "section": "A1",
   "title": "我是谁",
   "goal": "能说出并询问姓名、国籍、年龄、职业等个人信息",
   "rationale": "身份与归类是最高频的陈述；be 是英语句子的第一个骨架",
   "kcs": [
    "kt:en-word-order-svo",
    "kt:en-personal-pronouns",
    "kt:en-be-present",
    "kt:en-be-questions",
    "kt:en-lex-personal-info",
    "kt:en-lex-nationalities",
    "kt:en-fn-personal-info",
    "kt:en-phon-intonation-questions"
   ]
  },
  {
   "id": "a1-16",
   "section": "A1",
   "title": "课堂用语与听指令做动作",
   "goal": "能听懂\"坐下、打开书、指一指\"等指令并做出动作，能问\"这个用英语怎么说\"，能说出课堂物品与学科",
   "rationale": "\"怎么说\"是学习者自己获取新词的工具，越早越好；听指令做动作不依赖读写，是儿童课程的主要入口活动",
   "kcs": [
    "kt:en-fn-classroom-language",
    "kt:en-skill-listen-and-do",
    "kt:en-lex-school-classroom"
   ]
  },
  {
   "id": "a1-03",
   "section": "A1",
   "title": "这是什么",
   "goal": "能指着身边的东西问名字、说颜色和大小",
   "rationale": "指认与命名是最早的词汇扩展工具：学会 What's this? 就能自己问到新词",
   "kcs": [
    "kt:en-demonstratives",
    "kt:en-articles-a-an",
    "kt:en-noun-plural",
    "kt:en-orth-inflection-spelling",
    "kt:en-phon-s-endings",
    "kt:en-wh-questions",
    "kt:en-common-adjectives",
    "kt:en-lex-colours",
    "kt:en-lex-dimensions",
    "kt:en-lex-clothes"
   ]
  },
  {
   "id": "a1-04",
   "section": "A1",
   "title": "数字、价格与时间",
   "goal": "能听懂并说出数字、价格、钟点和日期，完成简单的买票或预约",
   "rationale": "数字是交易和时间安排的前提；A1 情景里最常出错也最容易测的信息",
   "kcs": [
    "kt:en-fn-numbers",
    "kt:en-numbers-ordinal-dates",
    "kt:en-lex-days-months",
